<script>
function toggleAcc(el) {
  const parent = el.parentElement;
  const isOpen = el.classList.contains('open');
  parent.querySelectorAll('.acc-item').forEach(item => item.classList.remove('open'));
  if (!isOpen) el.classList.add('open');
}
</script>

