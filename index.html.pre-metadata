    <!-- CHAPTER 00 — HERO -->
    <section class="chapter hero">
      <div class="chapter-badge"><div class="dot"></div><div class="num">00</div></div>
      <div class="chapter-label">Welcome</div>
      <div class="hero-grid">
        <div>
          <h1 class="chapter-title">Your organization, <span class="accent">finally in order.</span></h1>
          <p class="chapter-lead">MtaaLink is an all-in-one management platform for Kenyan organizations — members, money, meetings, projects, and reports. Runs in any browser. Free during early access.</p>
          <div class="cta">
            <a class="btn-p" href="https://mtaalink.org/register">Try it free →</a>
            <a class="btn-s" href="#features">See Features</a>
          </div>
        </div>
        <div class="stat-card">
          <div class="lbl-top">Chapter 00</div>
          <div>
            <div class="num">2025</div>
            <div class="lbl">Built in Kenya</div>
            <div class="desc">For any organization that meets, collects, and manages members.</div>
          </div>
        </div>
