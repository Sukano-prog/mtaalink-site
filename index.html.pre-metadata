        <div class="strip">
          <div class="n">02</div>
          <div><h4>Add your members and groups</h4><p>Type them in, or import from a list. Organize into groups as you go.</p></div>
          <div class="arrow">→</div>
        </div>
        <div class="strip">
          <div class="n">03</div>
          <div><h4>Run your organization</h4><p>Track contributions, hold meetings, manage projects, and export reports — all from your phone.</p></div>
          <div class="arrow">→</div>
        </div>
      </div>
    </section>

