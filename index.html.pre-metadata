<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MtaaLink — Your organization, finally in order</title>
<meta name="description" content="MtaaLink is an all-in-one management platform for Kenyan organizations — members, money, meetings, projects, and reports. Runs in any browser. Free during early access.">
<meta property="og:title" content="MtaaLink — Your organization, finally in order">
<meta property="og:description" content="Members, money, meetings, projects, and reports — all in one place. Free during early access.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body { font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; background:#160C08; color:#FBF8F1; overflow-x:hidden; -webkit-font-smoothing:antialiased; line-height:1.5; }

/* BACKGROUND */
.bg { position:fixed; inset:0; z-index:0; overflow:hidden; }
.bg::before { content:''; position:absolute; inset:0; background-image:repeating-linear-gradient(45deg, rgba(240,178,74,.02) 0 30px, transparent 30px 60px); }
.blob { position:absolute; border-radius:50%; filter:blur(140px); }
.b1 { width:650px; height:650px; background:#C75A3D; top:-250px; left:-200px; opacity:.25; }
.b2 { width:520px; height:520px; background:#F0B24A; bottom:-200px; right:-150px; opacity:.12; }

/* NAV */
.nav { position:fixed; top:16px; left:16px; right:16px; z-index:100;
  background:rgba(22,12,8,.65); backdrop-filter:blur(20px) saturate(160%); -webkit-backdrop-filter:blur(20px) saturate(160%);
  border:1px solid rgba(240,178,74,.15); border-radius:16px;
  padding:12px 22px; display:flex; justify-content:space-between; align-items:center;
  max-width:1160px; margin:0 auto; }
.logo { font-weight:800; font-size:16px; letter-spacing:-.02em; }
.logo span { color:#F0B24A; }
.nav-links { display:flex; gap:26px; font-size:13px; }
.nav-links a { color:rgba(251,248,241,.6); text-decoration:none; transition:color .2s; }
.nav-links a:hover { color:#F0B24A; }
.btn-go { background:#F0B24A; color:#160C08; border:none; padding:8px 18px; border-radius:9px; font-weight:700; font-size:13px; cursor:pointer; box-shadow:0 2px 0 rgba(240,178,74,.45); transition:all .15s; font-family:inherit; text-decoration:none; display:inline-block; }
.btn-go:hover { transform:translateY(-1px); box-shadow:0 3px 0 rgba(240,178,74,.45); }
.btn-go:active { transform:translateY(1px); box-shadow:0 1px 0 rgba(240,178,74,.45); }

/* LEDGER */
.page { position:relative; z-index:1; max-width:1160px; margin:0 auto; padding:0 40px; }
.ledger-track { position:relative; }
.ledger-track::before { content:''; position:absolute; left:56px; top:0; bottom:0; width:2px;
  background:linear-gradient(to bottom, transparent 0%, rgba(240,178,74,.15) 5%, rgba(240,178,74,.35) 20%, rgba(240,178,74,.35) 80%, rgba(240,178,74,.15) 95%, transparent 100%); }

/* CHAPTER */
.chapter { position:relative; padding:80px 0 80px 130px; }
.chapter-badge { position:absolute; left:0; top:80px; display:flex; align-items:center; gap:12px; }
.chapter-badge .dot { width:8px; height:8px; border-radius:50%; background:#F0B24A; box-shadow:0 0 0 4px rgba(240,178,74,.15), 0 0 0 8px rgba(240,178,74,.05); margin-left:53px; flex-shrink:0; }
.chapter-badge .num { font-family:'Courier New',monospace; font-size:11px; font-weight:700; letter-spacing:.15em; color:#F0B24A; padding:5px 9px; border:1px solid rgba(240,178,74,.35); border-radius:4px; background:rgba(240,178,74,.05); }
.chapter-label { font-family:'Courier New',monospace; font-size:11px; font-weight:700; letter-spacing:.25em; text-transform:uppercase; color:rgba(251,248,241,.4); margin-bottom:18px; }
.chapter-title { font-size:42px; font-weight:700; letter-spacing:-.03em; line-height:1.08; max-width:720px; margin-bottom:16px; }
.chapter-title .accent { color:#F0B24A; }
.chapter-lead { font-size:17px; line-height:1.55; color:rgba(251,248,241,.6); max-width:600px; margin-bottom:40px; }
.chapter.hero { padding-top:150px; padding-bottom:110px; }
.chapter.hero .chapter-title { font-size:68px; letter-spacing:-.045em; line-height:1; }

/* BUTTONS */
.cta { display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; }
.btn-p { background:#F0B24A; color:#160C08; padding:14px 28px; border-radius:10px; font-weight:700; font-size:14px; border:none; cursor:pointer; box-shadow:0 3px 0 rgba(240,178,74,.45); transition:all .15s; font-family:inherit; text-decoration:none; display:inline-block; }
.btn-p:hover { transform:translateY(-2px); box-shadow:0 5px 0 rgba(240,178,74,.45); }
.btn-p:active { transform:translateY(1px); box-shadow:0 1px 0 rgba(240,178,74,.45); }
.btn-s { background:transparent; color:#FBF8F1; border:1px solid rgba(240,178,74,.25); padding:14px 28px; border-radius:10px; font-weight:600; font-size:14px; cursor:pointer; transition:all .15s; font-family:inherit; text-decoration:none; display:inline-block; }
.btn-s:hover { border-color:rgba(240,178,74,.5); background:rgba(240,178,74,.04); }
.btn-s:active { transform:translateY(1px); }
.btn-t { background:transparent; color:#F0B24A; border:none; padding:14px 6px; font-weight:600; font-size:14px; cursor:pointer; border-bottom:2px solid #F0B24A; transition:all .15s; font-family:inherit; text-decoration:none; display:inline-block; }
.btn-t:hover { color:#F7C466; border-color:#F7C466; }

/* HERO */
.hero-grid { display:grid; grid-template-columns:1.4fr 1fr; gap:60px; align-items:center; }
.stat-card { border-radius:22px; padding:32px; background:rgba(240,178,74,.08); border:1px solid rgba(240,178,74,.25); display:flex; flex-direction:column; justify-content:space-between; aspect-ratio:5/4; }
.stat-card .lbl-top { font-family:'Courier New',monospace; font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:#F0B24A; font-weight:700; }
.stat-card .num { font-size:76px; font-weight:800; line-height:.9; color:#F0B24A; letter-spacing:-.05em; margin-top:auto; font-family:'Inter',sans-serif; }
.stat-card .lbl { font-size:13px; letter-spacing:.1em; text-transform:uppercase; color:rgba(251,248,241,.9); font-weight:600; margin-top:8px; }
.stat-card .desc { font-size:12px; color:rgba(251,248,241,.55); line-height:1.5; margin-top:12px; max-width:220px; }

/* SPLIT */
.split { display:grid; grid-template-columns:1fr 1fr; gap:2px; border-radius:18px; overflow:hidden; border:1px solid rgba(240,178,74,.15); }
.split-side { padding:32px 28px; }
.split-side.bad { background:rgba(255,255,255,.02); }
.split-side.good { background:rgba(240,178,74,.06); }
.split-side h3 { font-size:11px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; margin-bottom:18px; }
.split-side.bad h3 { color:rgba(226,122,91,.9); }
.split-side.good h3 { color:#F0B24A; }
.split-side ul { list-style:none; display:flex; flex-direction:column; gap:12px; }
.split-side li { font-size:14px; line-height:1.5; color:rgba(251,248,241,.7); padding-left:22px; position:relative; }
.split-side.bad li::before { content:'×'; position:absolute; left:0; color:#E27A5B; font-weight:800; font-size:16px; line-height:1.4; }
.split-side.good li::before { content:'✓'; position:absolute; left:0; color:#F0B24A; font-weight:800; }

/* ACCORDION */
.accordion { display:flex; flex-direction:column; gap:8px; }
.acc-item { border-radius:16px; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.08); overflow:hidden; transition:all .3s cubic-bezier(.2,.8,.2,1); }
.acc-item:hover { border-color:rgba(240,178,74,.25); }
.acc-item.open { background:rgba(240,178,74,.06); border-color:rgba(240,178,74,.35); }
.acc-header { display:flex; align-items:center; gap:20px; padding:20px 24px; cursor:pointer; user-select:none; transition:padding .2s; }
.acc-header:hover { padding-left:28px; }
.acc-num { font-family:'Courier New',monospace; font-size:11px; font-weight:700; color:rgba(240,178,74,.5); padding:6px 10px; border:1px solid rgba(240,178,74,.3); border-radius:4px; flex-shrink:0; min-width:38px; text-align:center; transition:all .3s; }
.acc-item.open .acc-num { color:#160C08; background:#F0B24A; border-color:#F0B24A; }
.acc-title { font-size:17px; font-weight:600; flex:1; letter-spacing:-.01em; transition:color .3s; }
.acc-item.open .acc-title { color:#F0B24A; }
.acc-toggle { font-family:'Courier New',monospace; font-size:22px; font-weight:300; color:rgba(240,178,74,.5); transition:all .3s; width:22px; text-align:center; flex-shrink:0; line-height:1; }
.acc-item.open .acc-toggle { color:#F0B24A; transform:rotate(45deg); }
.acc-body { max-height:0; overflow:hidden; transition:max-height .4s cubic-bezier(.2,.8,.2,1); }
.acc-item.open .acc-body { max-height:300px; }
.acc-body-inner { padding:0 24px 24px 24px; padding-left:80px; font-size:14px; line-height:1.65; color:rgba(251,248,241,.65); opacity:0; transition:opacity .3s .1s; }
.acc-item.open .acc-body-inner { opacity:1; }

/* STRIPS */
.strip { display:flex; align-items:center; gap:22px; padding:22px 28px; border-bottom:1px solid rgba(240,178,74,.12); transition:all .2s; }
.strip:hover { background:rgba(240,178,74,.03); padding-left:36px; }
.strip .n { font-size:26px; font-weight:800; color:rgba(240,178,74,.35); min-width:52px; font-family:'Courier New',monospace; letter-spacing:-.02em; }
.strip h4 { font-size:15px; font-weight:600; margin-bottom:4px; }
.strip p { font-size:13px; color:rgba(251,248,241,.55); line-height:1.5; }
.strip .arrow { color:#F0B24A; font-size:20px; margin-left:auto; transition:transform .2s; }
.strip:hover .arrow { transform:translateX(6px); }

/* RING */
.ring-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; max-width:760px; }
.ring { aspect-ratio:1; border-radius:50%; padding:36px; background:rgba(240,178,74,.05); border:1px solid rgba(240,178,74,.2); display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; transition:all .3s; position:relative; }
.ring::before { content:''; position:absolute; inset:10px; border-radius:50%; border:1px dashed rgba(240,178,74,.2); pointer-events:none; }
.ring:hover { border-color:rgba(240,178,74,.5); background:rgba(240,178,74,.08); }
.ring .num { font-family:'Courier New',monospace; font-size:10px; color:rgba(240,178,74,.6); margin-bottom:10px; letter-spacing:.15em; }
.ring h4 { font-size:16px; font-weight:700; margin-bottom:6px; }
.ring p { font-size:12px; color:rgba(251,248,241,.6); line-height:1.45; max-width:150px; }

/* TICK */
.tick-accordion { display:flex; flex-direction:column; gap:8px; }
.tick-item { display:flex; gap:18px; padding:20px 24px; border-radius:14px; background:rgba(255,255,255,.02); border:1px solid rgba(255,255,255,.08); cursor:pointer; transition:all .25s; align-items:flex-start; }
.tick-item:hover { border-color:rgba(240,178,74,.3); background:rgba(240,178,74,.04); }
.tick-item.open { border-color:rgba(240,178,74,.4); background:rgba(240,178,74,.06); }
.tick-item .check { width:44px; height:44px; border-radius:50%; border:2px solid #F0B24A; display:grid; place-items:center; color:#F0B24A; font-size:18px; font-weight:700; flex-shrink:0; transition:all .25s; }
.tick-item:hover .check, .tick-item.open .check { background:#F0B24A; color:#160C08; transform:rotate(-8deg); }
.tick-item .body { flex:1; }
.tick-item .body h4 { font-size:15px; font-weight:600; margin-bottom:0; transition:margin .3s; }
.tick-item.open .body h4 { margin-bottom:6px; }
.tick-item .body p { font-size:13px; line-height:1.55; color:rgba(251,248,241,.6); max-height:0; overflow:hidden; transition:max-height .35s, margin .35s; margin:0; }
.tick-item.open .body p { max-height:120px; }

/* PRICING */
.price-hero { display: grid; grid-template-columns: 1fr 1.3fr; gap: 2px; border-radius: 20px; overflow: hidden; border: 1px solid rgba(240,178,74,.25); background: rgba(240,178,74,.04); margin-bottom: 24px; }
.price-main { padding: 48px 40px; background: rgba(240,178,74,.08); display: flex; flex-direction: column; justify-content: center; }
.price-label { font-family: 'Courier New', monospace; font-size: 11px; font-weight: 800; letter-spacing: .25em; color: #F0B24A; text-transform: uppercase; margin-bottom: 8px; }
.price-amount { font-size: 84px; font-weight: 800; letter-spacing: -.05em; color: #F0B24A; line-height: .95; }
.price-period { font-size: 15px; color: rgba(251,248,241,.6); margin-top: 12px; letter-spacing: .05em; }
.price-includes { padding: 48px 40px; background: rgba(255,255,255,.01); }
.price-includes-title { font-family: 'Courier New', monospace; font-size: 11px; font-weight: 800; letter-spacing: .2em; color: rgba(240,178,74,.7); text-transform: uppercase; margin-bottom: 24px; }
.price-includes ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; }
.price-includes li { font-size: 14px; color: rgba(251,248,241,.75); padding-left: 24px; position: relative; line-height: 1.5; }
.price-includes li::before { content: '✓'; position: absolute; left: 0; color: #F0B24A; font-weight: 800; }

.ledger-actions { display:flex; gap:16px; align-items:center; flex-wrap:wrap; margin-top:6px; }
.ledger-actions .note { font-size:12px; color:rgba(251,248,241,.45); }

/* PANEL */
.panel { padding:52px 44px; border-radius:22px; background:#0F0704; border:1px solid rgba(240,178,74,.2); position:relative; overflow:hidden; }
.panel::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#C75A3D,#F0B24A,#C75A3D); }
.panel .k { font-size:11px; font-weight:800; letter-spacing:.22em; color:#F0B24A; text-transform:uppercase; margin-bottom:24px; font-family:'Courier New',monospace; }
.panel-with-image .panel-body { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: center; }
.panel-image { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 4/5; border: 1px solid rgba(240,178,74,.25); background: #0A0503; max-width: 280px; }
.panel-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9) contrast(1.05) brightness(.95); display: block; }
.panel-image::after { content: ''; position: absolute; top: 12px; left: 12px; width: 32px; height: 32px; border-top: 2px solid #F0B24A; border-left: 2px solid #F0B24A; border-radius: 6px 0 0 0; z-index: 2; opacity: .7; pointer-events: none; }
.panel-text h3 { font-size:34px; font-weight:700; letter-spacing:-.025em; line-height:1.12; margin-bottom:16px; }
.panel-text h3 .accent { color:#F0B24A; }
.panel-text p { font-size:15px; line-height:1.65; color:rgba(251,248,241,.65); max-width:540px; }

/* CTA FINAL */
.cta-final { padding:56px 44px; border-radius:22px; background:rgba(240,178,74,.10); border:1px solid rgba(240,178,74,.3); text-align:center; position:relative; overflow:hidden; }
.cta-final h2 { font-size:40px; font-weight:700; letter-spacing:-.03em; line-height:1.1; margin-bottom:12px; }
.cta-final h2 .accent { color:#F0B24A; }
.cta-final p { font-size:15px; color:rgba(251,248,241,.6); margin-bottom:28px; }
.cta-final .row { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }

/* FOOTER */
.footer { padding:56px 0 36px; border-top:1px solid rgba(240,178,74,.12); margin-top:64px; }
.footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1.4fr; gap:36px; margin-bottom:40px; }
.footer .logo { font-size:18px; margin-bottom:10px; }
.footer p { font-size:13px; color:rgba(251,248,241,.5); line-height:1.6; }
.footer h5 { font-size:10px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; color:#F0B24A; margin-bottom:14px; }
.footer a { color:rgba(251,248,241,.55); text-decoration:none; transition:color .2s; }
.footer a:hover { color:#F0B24A; }
.footer-nav a { display:block; font-size:13px; line-height:1.9; }

/* CONTACT ITEMS with icons */
.contact-list { display:flex; flex-direction:column; gap:10px; }
.contact-item { display:flex; align-items:center; gap:12px; font-size:13px; color:rgba(251,248,241,.65); text-decoration:none; transition:all .2s; padding:8px 10px; border-radius:8px; border:1px solid rgba(240,178,74,.15); background:rgba(240,178,74,.02); }
.contact-item:hover { border-color:rgba(240,178,74,.4); background:rgba(240,178,74,.06); color:#FBF8F1; }
.contact-item:hover .contact-icon { background:#F0B24A; color:#160C08; }
.contact-icon { width:32px; height:32px; border-radius:8px; background:rgba(240,178,74,.12); border:1px solid rgba(240,178,74,.25); display:grid; place-items:center; flex-shrink:0; transition:all .2s; color:#F0B24A; }
.contact-icon svg { width:16px; height:16px; display:block; }
.contact-text { display:flex; flex-direction:column; line-height:1.3; }
.contact-label { font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:rgba(240,178,74,.6); font-family:'Courier New',monospace; font-weight:700; }
.contact-value { font-size:13px; color:rgba(251,248,241,.75); }

.footer-bottom { padding-top:24px; border-top:1px solid rgba(240,178,74,.08); font-size:12px; color:rgba(251,248,241,.4); display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; }

@media(max-width:900px){
  .page { padding:0 20px; }
  .ledger-track::before { left:20px; }
  .chapter { padding:60px 0 60px 76px; }
  .chapter-badge { top:60px; }
  .chapter-badge .dot { margin-left:17px; }
  .chapter-title { font-size:28px; }
  .chapter.hero { padding-top:120px; padding-bottom:70px; }
  .chapter.hero .chapter-title { font-size:38px; }
  .chapter-lead { font-size:15px; margin-bottom:28px; }
  .hero-grid { grid-template-columns:1fr; gap:36px; }
  .split, .ring-grid, .footer-grid { grid-template-columns:1fr; }
  .panel, .cta-final { padding:32px 22px; }
  .panel h3, .cta-final h2 { font-size:24px; }
  .panel-text h3 { font-size:22px; }
  .nav-links { display:none; }
  .stat-card .num { font-size:56px; }
  .stat-card { padding:24px; }
  .panel-with-image .panel-body { grid-template-columns:1fr; gap:24px; }
  .panel-image { aspect-ratio: 16/10; max-width:100%; }
  .ring-grid { max-width:100%; }
  .acc-header { padding:16px 18px; gap:14px; }
  .acc-header:hover { padding-left:18px; }
  .acc-body-inner { padding:0 18px 18px 18px; padding-left:68px; font-size:13px; }
  .acc-title { font-size:14px; }
  .price-hero { grid-template-columns: 1fr; }
  .price-main { padding: 36px 24px; }
  .price-amount { font-size: 64px; }
  .price-includes { padding: 36px 24px; }
  .price-includes ul { grid-template-columns: 1fr; }
}

/* ============ DESKTOP SIZE FIX ============ */
@media(min-width:901px){
  .chapter { padding:60px 0 60px 130px; }
  .chapter-badge { top:60px; }
  .chapter-title { font-size:36px; margin-bottom:14px; }
  .chapter-lead { font-size:16px; margin-bottom:32px; }
  .chapter.hero { padding-top:130px; padding-bottom:80px; }
  .chapter.hero .chapter-title { font-size:58px; }

  .stat-card { padding:26px; aspect-ratio:6/5; }
  .stat-card .num { font-size:62px; }

  .acc-header { padding:16px 22px; gap:18px; }
  .acc-header:hover { padding-left:26px; }
  .acc-title { font-size:15px; }
  .acc-num { min-width:36px; padding:5px 9px; }
  .acc-toggle { font-size:20px; width:20px; }
  .acc-body-inner { padding:0 22px 20px 74px; font-size:13px; }

  .strip { padding:18px 24px; gap:18px; }
  .strip:hover { padding-left:32px; }
  .strip .n { font-size:22px; min-width:46px; }
  .strip h4 { font-size:14px; }
  .strip .arrow { font-size:18px; }

  .ring-grid { gap:20px; max-width:680px; }
  .ring { padding:28px; }
  .ring h4 { font-size:15px; }
  .ring p { font-size:11px; max-width:140px; }

  .tick-item { padding:16px 20px; gap:16px; }
  .tick-item .check { width:38px; height:38px; font-size:16px; }
  .tick-item .body h4 { font-size:14px; }

  .price-hero { border-radius:18px; margin-bottom:20px; }
  .price-main { padding:36px 32px; }
  .price-amount { font-size:68px; }
  .price-period { font-size:14px; margin-top:8px; }
  .price-includes { padding:36px 32px; }
  .price-includes-title { margin-bottom:18px; }
  .price-includes ul { gap:10px 22px; }
  .price-includes li { font-size:13px; }

  .panel { padding:40px 36px; }
  .panel .k { margin-bottom:18px; }
  .panel-with-image .panel-body { gap:32px; }
  .panel-image { max-width:240px; }
  .panel-text h3 { font-size:28px; margin-bottom:14px; }
  .panel-text p { font-size:14px; max-width:520px; }

  .cta-final { padding:44px 36px; }
  .cta-final h2 { font-size:32px; margin-bottom:12px; }
  .cta-final p { font-size:14px; margin-bottom:24px; }
}

</style></head><body>

<div class="bg"><div class="blob b1"></div><div class="blob b2"></div></div>

<nav class="nav">
  <div class="logo">Mtaa<span>Link</span></div>
