    <!-- CHAPTER 01 — PROBLEM -->
    <section class="chapter">
      <div class="chapter-badge"><div class="dot"></div><div class="num">01</div></div>
      <div class="chapter-label">The Problem</div>
      <h2 class="chapter-title">Running an organization <span class="accent">shouldn't be this hard.</span></h2>
      <p class="chapter-lead">Records scattered. Arguments about money. Minutes lost. Sound familiar?</p>
      <div class="split">
        <div class="split-side bad">
          <h3>Without MtaaLink</h3>
          <ul>
            <li>Records scattered across WhatsApp and notebooks</li>
            <li>Arguments about who paid and who didn't</li>
            <li>Meeting minutes lost or never written</li>
            <li>No clear picture of members or finances</li>
          </ul>
        </div>
        <div class="split-side good">
          <h3>With MtaaLink</h3>
          <ul>
            <li>Everything in one place, on your phone</li>
            <li>Every payment recorded, every member tracked</li>
            <li>Minutes generated automatically</li>
            <li>Reports you can show anyone, anytime</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CHAPTER 02 — FEATURES -->
    <section class="chapter" id="features">
      <div class="chapter-badge"><div class="dot"></div><div class="num">02</div></div>
      <div class="chapter-label">What It Does</div>
      <h2 class="chapter-title">Everything your organization needs.</h2>
      <p class="chapter-lead">Click each feature to see what it does. No more switching between apps.</p>

      <div class="accordion">
        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">01</div>
            <div class="acc-title">Members & Groups</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Full directory with roles, custom fields, and unlimited groups — organized the way your team actually works. Add members one at a time or import from a list.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">02</div>
            <div class="acc-title">Contributions</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Record every payment — M-PESA or cash. See who paid, who owes, and when. Full history that anyone in your team can review.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">03</div>
            <div class="acc-title">Meetings & Minutes</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Agendas, attendance, motions, and auto-generated minutes you can share immediately after the meeting. No more lost notebooks.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">04</div>
            <div class="acc-title">Projects</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Track milestones, budgets, and progress on every project — from start to completion. Everyone sees the same status.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">05</div>
            <div class="acc-title">Events</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Plan, invite, and check in — from fundraisers to formal gatherings. Track attendance and contributions in real time.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">06</div>
            <div class="acc-title">Expenses</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Track spending with categories, descriptions, and totals. See where every shilling goes — with clear, printable reports.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">07</div>
            <div class="acc-title">Reports & PDFs</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">Export member directories, meeting minutes, contribution history, and financial summaries to PDF. Share with anyone — board, donors, members.</div>
          </div>
        </div>

        <div class="acc-item" onclick="toggleAcc(this)">
          <div class="acc-header">
            <div class="acc-num">08</div>
            <div class="acc-title">Fast & Lightweight</div>
            <div class="acc-toggle">+</div>
          </div>
          <div class="acc-body">
            <div class="acc-body-inner">No app to download. Runs in your browser on any phone — Android, iPhone, or desktop. Installs to your home screen like a real app if you want.</div>
          </div>
        </div>
      </div>
    </section>

